{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Sales Trainer Modern Soft UI",
    "id": "sales-trainer-modern-soft-ui",
    "version": "1.0.0",
    "source": "web/ frontend codebase analysis"
  },
  "color": {
    "bg": {
      "main": { "$value": "#FAFAF9", "$type": "color" },
      "canvas": { "$value": "#F8FAFC", "$type": "color" },
      "card": { "$value": "#FFFFFF", "$type": "color" },
      "muted": { "$value": "#F1F5F9", "$type": "color" },
      "inverse": { "$value": "#0F172A", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#18181B", "$type": "color" },
      "secondary": { "$value": "#71717A", "$type": "color" },
      "tertiary": { "$value": "#A1A1AA", "$type": "color" },
      "muted": { "$value": "#64748B", "$type": "color" },
      "inverse": { "$value": "#FFFFFF", "$type": "color" }
    },
    "accent": {
      "blue": { "$value": "#3B82F6", "$type": "color" },
      "blueSoft": { "$value": "#EFF6FF", "$type": "color" },
      "purple": { "$value": "#8B5CF6", "$type": "color" },
      "purpleSoft": { "$value": "#F5F3FF", "$type": "color" },
      "anchor": { "$value": "#0F172A", "$type": "color" }
    },
    "semantic": {
      "success": { "bg": { "$value": "#F0FDF4", "$type": "color" }, "fg": { "$value": "#16A34A", "$type": "color" } },
      "warning": { "bg": { "$value": "#FFFBEB", "$type": "color" }, "fg": { "$value": "#D97706", "$type": "color" } },
      "error": { "bg": { "$value": "#FEF2F2", "$type": "color" }, "fg": { "$value": "#DC2626", "$type": "color" } },
      "info": { "bg": { "$value": "#EFF6FF", "$type": "color" }, "fg": { "$value": "#2563EB", "$type": "color" } }
    },
    "score": {
      "excellent": { "$value": "#52C41A", "$type": "color" },
      "good": { "$value": "#FAAD14", "$type": "color" },
      "poor": { "$value": "#F5222D", "$type": "color" },
      "ringTrack": { "$value": "#E2E8F0", "$type": "color" }
    },
    "dimension": {
      "value": { "$value": "#1890FF", "$type": "color" },
      "benefit": { "$value": "#52C41A", "$type": "color" },
      "evidence": { "$value": "#FAAD14", "$type": "color" },
      "objection": { "$value": "#722ED1", "$type": "color" },
      "closing": { "$value": "#EB2F96", "$type": "color" }
    },
    "voice": {
      "listening": { "$value": "#3B82F6", "$type": "color" },
      "speaking": { "$value": "#8B5CF6", "$type": "color" },
      "active": { "$value": "#06B6D4", "$type": "color" },
      "idle": { "$value": "#94A3B8", "$type": "color" }
    },
    "glass": {
      "bg": { "$value": "rgba(255,255,255,0.65)", "$type": "color" },
      "border": { "$value": "rgba(255,255,255,0.60)", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "Avenir Next, Segoe UI, PingFang SC, Microsoft YaHei, Heiti SC, system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SF Mono, Cascadia Code, monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "18px", "$type": "dimension" },
      "xl": { "$value": "20px", "$type": "dimension" },
      "2xl": { "$value": "24px", "$type": "dimension" },
      "3xl": { "$value": "32px", "$type": "dimension" }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" }
  },
  "radius": {
    "lg": { "$value": "16px", "$type": "dimension" },
    "2xl": { "$value": "32px", "$type": "dimension" },
    "shell": { "$value": "40px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "card": { "$value": "0 8px 30px rgb(0,0,0,0.04)", "$type": "shadow" },
    "anchor": { "$value": "0 10px 15px -3px rgba(15,23,42,0.20)", "$type": "shadow" }
  }
}
